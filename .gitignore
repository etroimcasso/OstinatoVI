# OS noise
.DS_Store

# ROM files are never committed, anywhere in the tree
*.sfc
*.smc
*.fig

# ROM-derived content is never committed; directory structure is preserved
# via .gitkeep
assets/*/default/*
!assets/*/default/.gitkeep

# Text corpus directories: ROM-derived text is never committed. Structure kept
# via .gitkeep.
assets/text/*/*
!assets/text/*/.gitkeep

# Build output
build/

# The upstream disassembly, cloned locally for development (everything8215/ff6). It is never
# part of this repository.
/original-src/

# Private working docs — local only, never pushed to the public remote.
# (Tracked on pre-restructure local branches; ignored everywhere going forward.)
docs-internal/
/CLAUDE.md
